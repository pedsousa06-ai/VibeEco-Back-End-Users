# Copie este arquivo para ".env" e ajuste. Sem o .env a API usa estes mesmos valores padrão.
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=bcd127
DB_NAME=db_vibeEco_2026

# Autenticação (JWT). Troque o segredo por um texto longo e aleatório.
JWT_SECRET=troque-este-segredo-por-um-texto-longo-e-aleatorio
JWT_EXPIRES_IN=10800
# true = toda rota exige login (token). false = rotas sem token continuam abertas (app Android sem login ainda).
AUTH_OBRIGATORIA=false

# Recuperação de senha por e-mail (Gmail com "senha de app"). Vazio = o código aparece no console da API.
EMAIL_USER=
EMAIL_PASSWORD=
# Só desenvolvimento: devolve o código de recuperação na resposta da API (não use em produção)
EXPOR_CODIGO_DEV=false
